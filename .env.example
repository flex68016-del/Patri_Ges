# JWT Keys (générées avec: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA..."
-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQD..."
-----END PRIVATE KEY-----"

# PostgreSQL (environnement local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Auth Service
AUTH_DB_DATABASE=auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=auth_password

# Patrimoine Service
PATRIMOINE_DB_DATABASE=patrimoine_db
PATRIMOINE_DB_USERNAME=patrimoine_user
PATRIMOINE_DB_PASSWORD=patrimoine_password

# Operations Service
OPERATIONS_DB_DATABASE=operations_db
OPERATIONS_DB_USERNAME=operations_user
OPERATIONS_DB_PASSWORD=operations_password

# URLs des services (environnement local)
AUTH_SERVICE_URL=http://localhost:8001
PATRIMOINE_SERVICE_URL=http://localhost:8002
OPERATIONS_SERVICE_URL=http://localhost:8003
WEB_URL=http://localhost:8000

# Configuration application
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:your-app-key-here

# Pour production (Render)
# DATABASE_URL=postgresql://user:password@host:port/database
